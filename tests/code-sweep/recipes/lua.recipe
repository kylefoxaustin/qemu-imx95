# SPDX-License-Identifier: GPL-2.0-or-later
# Lua - a full scripting-language interpreter. Built static from the reference
# sources, then driven in-guest by a script that asserts known results across
# strings, tables, integer/float arithmetic, closures, coroutines, metatables,
# string.format and pattern matching. Any assert failure aborts non-zero. This
# exercises a real bytecode VM (not just a leaf routine) on the A55.
NAME=lua
CATEGORY=interpreter
SRC=https://www.lua.org/ftp/lua-5.4.7.tar.gz
REF=5.4.7

cs_build() {
    cd src
    # LUA_USE_POSIX keeps it free of readline/dlopen so -static links cleanly.
    srcs=$(ls *.c | grep -vE '^(luac|onelua)\.c$')
    "$CC" -O2 -static -DLUA_USE_POSIX -o "$OUT/lua" $srcs -lm \
        || { echo "  lua cross-build failed"; return 1; }
    "$STRIP" "$OUT/lua" 2>/dev/null || true
    cd ..

    cat > "$OUT/selftest.lua" <<'LUA'
local function eq(a,b,m) if a~=b then error((m or "").." : "..tostring(a).." ~= "..tostring(b)) end end
-- integer vs float (5.4 distinction)
eq(3//2, 1); eq(7%3, 1); eq(2^10, 1024.0); eq(math.type(1),"integer"); eq(math.type(1.0),"float")
eq(math.maxinteger+1, math.mininteger)            -- wraparound
-- strings + patterns + format
eq(("Hello, World"):upper(), "HELLO, WORLD")
eq(string.format("%08.3f", 3.14159), "0003.142")
eq(select(2, ("k1=v1;k2=v2"):gsub("(%w+)=(%w+)","%2:%1")), 2)
eq(("  trim me  "):match("^%s*(.-)%s*$"), "trim me")
-- tables / sort / concat
local t={5,3,9,1,7}; table.sort(t); eq(table.concat(t,","), "1,3,5,7,9")
-- closures
local function counter() local n=0; return function() n=n+1; return n end end
local c=counter(); c(); c(); eq(c(), 3)
-- coroutines
local function gen(n) for i=1,n do coroutine.yield(i*i) end end
local co=coroutine.wrap(function() gen(4) end)
eq(co()+co()+co()+co(), 1+4+9+16)
-- metatables
local V=setmetatable({1,2},{__add=function(a,b) return {a[1]+b[1],a[2]+b[2]} end})
local s=V+{10,20}; eq(s[1],11); eq(s[2],22)
-- numeric oracle: sum of squares 1..1000
local acc=0; for i=1,1000 do acc=acc+i*i end; eq(acc, 333833500)
print("LUA_OK ".._VERSION)
LUA

    cat > "$OUT/runtest.sh" <<'GUEST'
#!/bin/sh
echo "[lua] run interpreter self-test"
out=$(./lua selftest.lua 2>&1) || { echo "$out"; echo "[lua] FAILED"; exit 1; }
echo "$out"
case "$out" in *LUA_OK*) echo "[lua] OK" ;; *) echo "[lua] no OK marker"; exit 1 ;; esac
GUEST
    chmod +x "$OUT/runtest.sh"
}
