# SPDX-License-Identifier: GPL-2.0-or-later
# Network datapath: real traffic over the from-scratch ENETC NIC. We cross-build
# a static BusyBox (itself real third-party code, and the only way to get net
# tooling into the busybox initramfs, which ships none), bring eth0 up, and pull
# a random payload + its sha over TFTP from slirp's built-in server at 10.0.2.2,
# then sha256-verify. This exercises the ENETC TX/RX BD-ring datapath end to end
# (the payload only verifies if every byte crossed the emulated MAC correctly).
#
# The harness (run-peripheral.sh) serves $WORK/tftp via -nic ...,tftp=, so the
# files netpayload.bin + netpayload.sha appear at 10.0.2.2.
NAME=net-tftp
CATEGORY=network
CS_KEY=m95-net-enetc          # 95 is ENETC (not FEC/eQOS) -> machine-specific key
SRC=https://busybox.net/downloads/busybox-1.36.1.tar.bz2
REF=1.36.1

cs_build() {
    make defconfig >/dev/null 2>&1
    for opt in CONFIG_STATIC CONFIG_TFTP CONFIG_FEATURE_TFTP_GET \
               CONFIG_IFCONFIG CONFIG_ROUTE CONFIG_SHA256SUM; do
        sed -i "s/^# $opt is not set/$opt=y/; s/^$opt=.*/$opt=y/" .config
    done
    yes "" | make oldconfig >/dev/null 2>&1
    make ARCH=arm64 CROSS_COMPILE="${CC%gcc}" -j"$(nproc)" >/dev/null 2>&1
    [ -x busybox ] || { echo "  busybox build failed"; return 1; }
    cp busybox "$OUT/"; "$STRIP" "$OUT/busybox" 2>/dev/null || true

    cat > "$OUT/runtest.sh" <<'GUEST'
#!/bin/sh
HERE=$(cd "$(dirname "$0")" && pwd); BB="$HERE/busybox"; cd "$HERE"
# The machine has THREE ENETC PFs (ENETC0/1/2) but only ENETC0 carries the slirp
# backend. Linux's interface naming across the three identical PFs is NOT
# deterministic (probe order), so the backed PF is not always "eth0" - assuming
# eth0 made the test flake ~7% of boots (eth0 landed on a back-end-less PF: RX
# dead, TX into the void). So: enumerate every non-loopback interface and use
# whichever one actually reaches slirp. That tests the ENETC datapath regardless
# of which name the backed PF got.
ifaces=""
i=0; while [ $i -lt 30 ]; do
    ifaces=$(for d in /sys/class/net/*; do n=$(basename "$d"); [ "$n" = lo ] || echo "$n"; done)
    [ -n "$ifaces" ] && break; sleep 1; i=$((i+1))
done
[ -n "$ifaces" ] || { echo "[net] no ENETC interfaces present - skipping"; exit 77; }
echo "[net] candidate interfaces:$ifaces"
fetch_on() {  # $1=iface $2=file ; try over that iface with a few retries
    "$BB" ifconfig "$1" 10.0.2.15 netmask 255.255.255.0 up 2>/dev/null
    "$BB" route add default gw 10.0.2.2 2>/dev/null
    n=0; while [ $n -lt 4 ]; do
        rm -f "$2"; "$BB" tftp -g -r "$2" 10.0.2.2 2>/dev/null && [ -s "$2" ] && return 0
        n=$((n+1)); sleep 2
    done
    "$BB" ifconfig "$1" 0.0.0.0 down 2>/dev/null; return 1
}
DEV=""
for ifc in $ifaces; do
    if fetch_on "$ifc" netpayload.sha; then DEV="$ifc"; break; fi
done
if [ -z "$DEV" ]; then
    echo "[net] no interface reached slirp over ENETC"
    echo "[net] DIAG:"; for ifc in $ifaces; do
        echo "  $ifc -> $(basename "$(readlink -f /sys/class/net/$ifc/device 2>/dev/null)") $("$BB" ifconfig "$ifc" 2>/dev/null | grep -o 'RX packets:[0-9]*')"; done
    exit 1
fi
echo "[net] slirp reachable via $DEV (PF $(basename "$(readlink -f /sys/class/net/$DEV/device 2>/dev/null)"))"
"$BB" tftp -g -r netpayload.bin 10.0.2.2 || { echo "[net] payload fetch failed"; exit 1; }
want=$(cat netpayload.sha)
got=$("$BB" sha256sum netpayload.bin | awk '{print $1}')
[ -n "$got" ] && [ "$want" = "$got" ] || { echo "[net] sha mismatch: $got != $want"; exit 1; }
echo "[net] OK ($("$BB" wc -c < netpayload.bin) bytes pulled over ENETC ($DEV), sha256 verified)"
GUEST
    chmod +x "$OUT/runtest.sh"
}
